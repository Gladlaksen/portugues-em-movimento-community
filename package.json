{
  "name": "portugues-em-movimento",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first, voice-first European Portuguese course for Codex and ChatGPT.",
  "scripts": {
    "build": "pnpm run build:services && pnpm run build:dashboard",
    "build:dashboard": "vite build",
    "build:services": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mcp-server.js && esbuild src/dashboard/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/dashboard-server.js",
    "dashboard": "node dist/dashboard-server.js",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "mcp": "node dist/mcp-server.js",
    "test": "tsx --test test/*.test.ts",
    "test:mcp": "tsx test/mcp-smoke.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@10.22.0"
}
